{
  "schemaVersion": 2,
  "schema": "healthhub-cloud-vault-v2",
  "provider": "dropbox",
  "providerMode": "app_folder",
  "root": "/HealthHub",
  "localCache": {
    "structured": "IndexedDB",
    "daily": "localStorage",
    "strategy": "offline-first"
  },
  "collections": {
    "profiles": "/HealthHub/profiles",
    "documents": "/HealthHub/documents",
    "explanations": "/HealthHub/explanations",
    "devices": "/HealthHub/devices",
    "measurements": "/HealthHub/measurements",
    "appointments": "/HealthHub/appointments",
    "daily": "/HealthHub/daily",
    "sync": "/HealthHub/sync",
    "master": "/HealthHub/master",
    "orchestrator": "/HealthHub/orchestrator"
  },
  "daily": {
    "spark": "/HealthHub/daily/daily-spark.json",
    "briefing": "/HealthHub/daily/daily-briefing.json",
    "readPriority": [
      "dropbox",
      "local-cache",
      "github-fallback"
    ],
    "sparkSelfHeal": true,
    "briefingGenerator": "healthhub-connect-android",
    "schedule": {
      "spark": "05:30",
      "briefing": "06:00",
      "timezone": "Europe/Budapest"
    }
  },
  "binary": {
    "documentFiles": "/HealthHub/documents/files",
    "deviceImages": "/HealthHub/devices/images"
  },
  "syncModel": {
    "mode": "cloud-primary-local-cache",
    "conflictPolicy": "updatedAt-last-write-wins",
    "requireEntityUpdatedAt": true,
    "tombstones": "/HealthHub/sync/tombstones.json",
    "manifest": "/HealthHub/manifest.json",
    "structuredSourceOfTruth": "/HealthHub/master"
  },
  "security": {
    "oauth": "authorization-code-pkce",
    "tokenLocation": "Web localStorage (current) + Android SharedPreferences",
    "repositoryStoresTokens": false,
    "repositoryStoresPrivateHealthData": false,
    "tokenHardening": "planned"
  },
  "profiles": {
    "vaultTemplate": "/HealthHub/profiles/{profile}-vault.json",
    "healthConnectTemplate": "/HealthHub/profiles/{profile}-health-connect.json",
    "legacyVaultFallback": "/{profile}-data.json",
    "legacyHealthConnectFallback": "/incoming-{profile}.json"
  },
  "healthConnect": {
    "source": "Android Health Connect",
    "writer": "HealthHub Connect",
    "cloudPath": "/HealthHub/profiles/{profile}-health-connect.json",
    "consumers": [
      "HealthRadar",
      "Activity",
      "Sleep",
      "Insights"
    ],
    "webImportCache": "IndexedDB healthhub-connect-v1"
  },
  "master": {
    "role": "single-source-of-truth-for-structured-json",
    "root": "/HealthHub/master",
    "files": {
      "manifest": "/HealthHub/master/manifest.json",
      "documents": "/HealthHub/master/documents.json",
      "explanations": "/HealthHub/master/explanations.json",
      "medications": "/HealthHub/master/medications.json",
      "profiles": "/HealthHub/master/profiles.json",
      "appointments": "/HealthHub/master/appointments.json"
    },
    "localCache": "IndexedDB healthhub-healthradar-v2",
    "bootstrap": "merge-local-and-cloud-without-destructive-delete"
  },
  "orchestrator": {
    "schema": "healthhub.orchestrator/1",
    "root": "/HealthHub/orchestrator",
    "devices": "/HealthHub/orchestrator/devices/{deviceId}.json",
    "commands": "/HealthHub/orchestrator/commands/{deviceId}.json",
    "status": "/HealthHub/orchestrator/status/{deviceId}.json",
    "execution": {
      "web": "startup + focus/visibility/online + visible 60s command check",
      "android": "WorkManager 15 minute background check + immediate app-open check",
      "offline": "pending command is executed on next available check"
    },
    "privacy": "technical device/status metadata only; no clinical values in orchestrator records",
    "commandExpiryHours": 24
  }
}
