<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:label="SH9 Watch Bridge PILOT"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".PhonePilotActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Google Play services invokes this only for the exact Data Layer message path. -->
        <service android:name=".WatchPilotReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/sh9/watch/pilot/v1" />
            </intent-filter>
        </service>
    </application>
</manifest>
